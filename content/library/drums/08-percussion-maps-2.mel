// Finale SongWriter 2012 Percussion Maps Reference
// https://usermanuals.finalemusic.com/SongWriter2012Win/Content/PercussionMaps.htm

bpm(85)

open = midi(16,46,60)
close = midi(16,42,60)
clap = midi(16,39,60)
kick = midi(16,36,80)

d1 = notemap('!..!..!..!..!..!',open)
d2 = notemap('..!..!..!..!..!.',kick)
d3 = notemap('.!..!..!..!..!..',close)
dset = channel(10,merge(d1,d2,d3))
lp_set = loop(dset)


// Big Room
kick = note('16f2++')
k1 = notemap('!!..!!..!.!.!...',kick)
lp_k1 = loop(k1)